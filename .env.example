# =============================================================================
# AIST-FYP Environment Variables
# =============================================================================
#
# INSTRUCTIONS:
# 1. Copy this file to .env (without .example extension)
# 2. Fill in your actual API keys and credentials
# 3. Never commit .env file to version control (it's in .gitignore)
#
# =============================================================================

# DeepSeek API Configuration (Required for LLM entity matcher and CiteEval)
# Get your key from: https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# CiteEval Configuration
CITEEVAL_PROVIDER=deepseek
CITEEVAL_ROOT=benchmark/CiteEval
# Use : as separator for PYTHONPATH (standard for CiteEval scripts)
PYTHONPATH=benchmark/CiteEval:benchmark/CiteEval/src

# OpenAI API Configuration (Optional, for Ragas evaluation or CiteEval with OpenAI)
# Get your key from: https://platform.openai.com/api-keys
# OPENAI_API_KEY=your_openai_api_key_here

# Optional: OpenAI Organization ID (if you belong to multiple organizations)
# OPENAI_ORG_ID=your_organization_id_here

# Optional: Azure OpenAI Configuration (if using Azure instead of OpenAI)
# AZURE_OPENAI_API_KEY=your_azure_openai_key_here
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_API_VERSION=2023-05-15

# Other API Keys (for future integrations)
# HUGGINGFACE_TOKEN=your_huggingface_token_here
# ANTHROPIC_API_KEY=your_anthropic_key_here
